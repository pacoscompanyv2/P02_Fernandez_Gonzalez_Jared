# Copia este archivo a .env (cp .env.example .env) y cambia la clave. NUNCA subas .env al repositorio.
# Datos sinteticos y locales: no uses una clave que uses en otro lado.

# --- lo lee Docker Compose ---
POSTGRES_DB=tcsw_ventas
POSTGRES_USER=tcsw_app
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_PORT=5432

# --- lo lee la aplicacion y las pruebas (exportalas: set -a; . ./.env; set +a) ---
TCSW_DB_URL=jdbc:postgresql://localhost:5432/tcsw_ventas
TCSW_DB_USER=tcsw_app
TCSW_DB_PASSWORD=cambia_esta_clave
# base aparte para pruebas de integracion (debe terminar en _test; el TRUNCATE de las pruebas solo la toca a ella)
TCSW_TEST_DB_URL=jdbc:postgresql://localhost:5432/tcsw_ventas_test
