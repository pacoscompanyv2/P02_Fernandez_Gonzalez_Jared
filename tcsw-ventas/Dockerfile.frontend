# Cliente Angular 21 servido por nginx. Contexto de construccion: la RAIZ del repositorio (compose: context: ..)
# nginx entrega la pagina y reenvia /api/ a la API (mismo papel que proxy.conf.json en desarrollo).
FROM node:22.12-bookworm-slim AS build
WORKDIR /app
# npm fijado a 10.9.8 (el de packageManager). Se usa 'npm install' y no 'npm ci': dentro de la imagen 'npm ci' falla con
# 'Missing: @emnapi/... from lock file' aunque el lock pasa en la maquina del autor (causa no determinada; ver bitacora-c04.md).
# 'npm install' respeta package-lock.json y solo completa lo que falta.
COPY cliente-angular/package.json cliente-angular/package-lock.json ./
RUN npm install -g npm@10.9.8 && npm install --no-audit --no-fund
COPY cliente-angular/ ./
RUN npx ng build --configuration production

FROM nginx:1.27-alpine
COPY tcsw-ventas/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/cliente-angular/browser /usr/share/nginx/html
EXPOSE 80
